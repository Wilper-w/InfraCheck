# InfraCheck 真实环境接入配置
# 链路: 本机(免密) --SSH--> 跳板机 --ssh <alias>--> 环境节点

# 1) 平台 -> 跳板机（免密，用本机默认 ~/.ssh 密钥）
RUNNER_TRANSPORT=ssh
JUMP_HOST=<jump-host-ip>
JUMP_USER=jump
JUMP_KEY=

# 2) 跳板机 -> 环境：用跳板机自身的 alias 连节点（关键）
SSH_VIA_JUMP_SHELL=1
# SSH_VIA_JUMP_USER=root

# 3) 目标/兜底账号与连接参数
SSH_USER=root
SSH_PORT=22
SSH_TIMEOUT=15
RUN_CONCURRENCY=10

# 4) 数据库：本机一个独立 sqlite 文件，与开发/演示库隔离
DATABASE_URL=sqlite:////Users/wilper/Downloads/AI大模型推理平台/InfraCheck/backend/infracheck-prod.db
JWT_SECRET=infracheck-real-secret-change-me-please-64bytes

# mysql 集群默认密码（必填；key 只放本地 .env，勿提交）
MYSQL_DEFAULT_PW=
